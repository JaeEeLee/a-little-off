# 사진·아이콘·포스터는 하루 동안 휴대폰에 저장해 두고 쓴다 (그 뒤 일주일까지는 저장본을 먼저 보여 주고 뒤에서 새로 확인)
/works/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og-image.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon-*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# 작가 개인 페이지(지인에게 보내는 초대 · 예약 링크)는 검색에 나오지 않게 한다
/jessie
  X-Robots-Tag: noindex, follow
/jessie/*
  X-Robots-Tag: noindex, follow
